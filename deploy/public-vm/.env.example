# The deploy script builds this image locally on the VM.
NEXUS_EDGE_IMAGE=nexusproxy-edge:local

# Ports exposed by the VM. Open both as TCP rules in the cloud firewall.
NEXUS_TUNNEL_PORT=7000
NEXUS_PUBLIC_PORT=8000

# Set these to the numeric UID and GID returned by `id -u` and `id -g`.
# The container remains non-root and can read secrets owned by that account.
NEXUS_RUNTIME_UID=1000
NEXUS_RUNTIME_GID=1000

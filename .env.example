# Edge certificate and private-key paths. Mount the actual files at runtime.
NEXUS_TLS_CERT_FILE=/run/secrets/nexus-edge-certificate.pem
NEXUS_TLS_KEY_FILE=/run/secrets/nexus-edge-private-key.pem

# Client trust root and the DNS name/IP expected in the edge certificate.
NEXUS_TLS_CA_FILE=/run/secrets/nexus-edge-ca.pem
NEXUS_TLS_SERVER_NAME=edge.example.com

# Recommended for both processes: mount the same random token as a file.
NEXUS_AUTH_TOKEN_FILE=/run/secrets/nexus-auth-token

# Local development alternative. Never commit a real value.
# NEXUS_AUTH_TOKEN=
